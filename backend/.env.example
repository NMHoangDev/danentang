# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# ============================================================================
# SUPABASE CONFIGURATION (PostgreSQL Database & Auth)
# ============================================================================
# Điền Project URL và API Keys từ Supabase Dashboard (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chế độ Fallback thông minh:
# Khi chưa điền SUPABASE_URL / KEY thật, hệ thống tự động kích hoạt Local Supabase
# PostgreSQL Store (lưu tại backend/data/local-supabase.json) để đảm bảo Backend
# & App React Native luôn chạy ổn định 100% khi phát triển!
SUPABASE_ALLOW_LOCAL_FALLBACK=true
